# Maintainer: Guido Naselli <guidonaselli@gmail.com>
pkgname=gittree
pkgver=1.0.0
pkgrel=1
pkgdesc="Git and submodule workspace client"
arch=('x86_64')
url="https://github.com/guidonaselli/gittree"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'git' 'openssl')
makedepends=('cargo' 'nodejs' 'pnpm')
source=("gittree.desktop")
sha256sums=('dccff43988d6393e4d4e4cad781a0e90247f540550c482fb45f97dc2a26dc948')

build() {
  local repo_root="$startdir/../.."
  if [ ! -f "$repo_root/target/release/gittree" ]; then
    cd "$repo_root"
    pnpm --dir frontend install --frozen-lockfile
    pnpm --dir frontend build
    cargo build --release -p gittree
  fi
}

package() {
  local repo_root="$startdir/../.."

  install -Dm755 "$repo_root/target/release/gittree" "$pkgdir/usr/bin/gittree"
  install -Dm644 "$srcdir/gittree.desktop" "$pkgdir/usr/share/applications/gittree.desktop"

  install -Dm644 "$repo_root/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/gittree.png"
  install -Dm644 "$repo_root/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/gittree.png"
  install -Dm644 "$repo_root/src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/gittree.png"
  install -Dm644 "$repo_root/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/gittree.png"

  if [ -f "$repo_root/LICENSE" ]; then
    install -Dm644 "$repo_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
